{
  "name": "@vcalderondev/ukit-css",
  "version": "1.1.1",
  "description": "JIT utility-first CSS engine — Tailwind-style on-demand class generation for any framework (React, Vue, Angular, Svelte, Next.js, Astro, vanilla HTML).",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "ukit-css": "bin/ukit-css.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./engine": {
      "types": "./dist/engine.d.ts",
      "import": "./dist/engine.js",
      "require": "./dist/engine.cjs"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "import": "./dist/manifest.js",
      "require": "./dist/manifest.cjs"
    },
    "./ukit.manifest.json": "./ukit.manifest.json",
    "./ukit.classes.txt": "./ukit.classes.txt",
    "./postcss": {
      "types": "./dist/postcss.d.ts",
      "import": "./dist/postcss.js",
      "require": "./dist/postcss.cjs"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js",
      "require": "./dist/vite.cjs"
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "AGENTS.md",
    "llms.txt",
    "docs",
    "ukit.manifest.json",
    "ukit.classes.txt"
  ],
  "scripts": {
    "build": "npm run generate && tsup",
    "prepublishOnly": "npm run build",
    "dev": "tsup --watch",
    "generate": "node scripts/generate.mjs",
    "generate:check": "node scripts/generate.mjs --check",
    "release:check": "node scripts/check-release.mjs",
    "vendor": "node editors/vscode/scripts/vendor.mjs",
    "check:vendor": "node scripts/check-vendor.mjs",
    "test": "node --import ./scripts/ts-resolve-register.mjs --test \"test/**/*.test.mjs\"",
    "test:extension": "node editors/vscode/test/selftest.mjs && node editors/vscode/test/integration.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run generate:check && npm test && npm run build && npm run check:vendor && npm run test:extension",
    "format": "prettier --write \"src/**/*.ts\" \"bin/**/*.mjs\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"bin/**/*.mjs\" \"scripts/**/*.mjs\""
  },
  "dependencies": {
    "chokidar": "^3.6.0",
    "fast-glob": "^3.3.2",
    "kleur": "^4.1.5"
  },
  "peerDependencies": {
    "postcss": "^8.4.0",
    "vite": "^4.0.0 || ^5.0.0 || ^6.0.0"
  },
  "peerDependenciesMeta": {
    "postcss": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "postcss": "^8.5.14",
    "prettier": "^3.8.3",
    "tsup": "^8.0.2",
    "typescript": "^5.4.0",
    "vite": "^5.4.21"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vcalderondev/ukit-css.git"
  },
  "keywords": [
    "css",
    "jit",
    "utility-first",
    "tailwind-like",
    "atomic-css",
    "postcss",
    "vite",
    "ukit-css",
    "autocomplete",
    "intellisense",
    "typescript-types"
  ],
  "publishConfig": {
    "access": "public"
  },
  "author": "Victor Calderon <mail@vcalderon.dev>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/vcalderondev/ukit-css/issues"
  },
  "homepage": "https://github.com/vcalderondev/ukit-css#readme"
}
